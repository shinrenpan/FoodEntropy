    "iCloud 同步將於下次開啟 App 後生效。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync will take effect the next time you open the app."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步將於下次開啟 App 後生效。"
          }
        }
      }
    },
    "iCloud 同步預設關閉；開啟後將備份至你的 iCloud。通知權限請於系統設定調整。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync is off by default; when on, your data is backed up to your iCloud. Adjust notification permissions in system Settings."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步預設關閉；開啟後將備份至你的 iCloud。通知權限請於系統設定調整。"
          }
        }
      }
    },
    "一次性購買，永久移除首頁橫幅廣告。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
