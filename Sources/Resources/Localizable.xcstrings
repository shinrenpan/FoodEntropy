        }
      }
    },
    "iCloud sync is off by default; when on, your data is backed up to your iCloud. Adjust notification permissions in system Settings." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步預設關閉；開啟後將備份至你的 iCloud。通知權限請於系統設定調整。"
          }
